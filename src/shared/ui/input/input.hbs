<input 
    autocomplete="off"
    type={{type}}
    class="form__input {{#if isInvalid}} 'invalid' {{/if}} {{class}}"
    name={{name}}
    id={{id}}
    accept={{accept}}
    multiple={{multiple}}
    {{#if value}} value="{{value}}" {{/if}}
    {{#if isDisabled}} disabled {{/if}}
    {{#if isRequired}} required {{/if}}
/>