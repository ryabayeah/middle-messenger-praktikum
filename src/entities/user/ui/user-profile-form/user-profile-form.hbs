<div class='form-profile'>
  <form class='form-profile__content'>
    <div class='avatar-section'>
      <div class='avatar-section__wrapper'>
        {{{avatar}}}
        <span class='bold'>{{display_name}}</span>
      </div>
    </div>
    <div class='fields-section'>
      <div class='form-profile__fields'>
        {{{formFields}}}
      </div>

      <div class='form-profile__buttons'>
        {{#if isEditable}}
          {{{saveButton}}}
          {{{altButton}}}
        {{else}}
          {{{editProfileButton}}}
          {{{editPasswordButton}}}
          {{{logOutButton}}}
        {{/if}}
      </div>
    </div>
  </form>
  {{{userAvatarModal}}}
</div>