<div class="dialog-card">
    {{> Avatar class='dialog-card__avatar' }}
    <div class='dialog-card__message'>
        <div class="wrapper left">
            <span class="dialog-card__message-name">{{name}}</span>
            <span class="text-secondary dialog-card__message-last">
                {{#if isLastMe}}
                <span>Вы:</span>
                {{/if}}
                {{lastMessage}}
            </span>
        </div>
        <div class="wrapper right">
            <span class="text-secondary dialog-card__message-time">15:35</span>
            <span class="dialog-card__message-count">4</span>
        </div>

    </div>
</div>