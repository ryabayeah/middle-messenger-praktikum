<div class="message-bubble {{#if message}}msg__text{{else}}msg__attachment{{/if}}{{#if isOuter}} outer {{else}} inner {{/if}}">
{{#if message}}
    {{message}}
{{/if}}

{{#if img}}
    <img class="message_attachment" src="{{img}}" alt="Вложение"/>
{{/if}}
    <div class="message_send">
         <svg xmlns="http://www.w3.org/2000/svg" width="10" height="5" viewBox="0 0 10 5" fill="none" class="send_status">
            <line y1="-0.5" x2="3.765" y2="-0.5"
                transform="matrix(0.705933 0.708278 -0.705933 0.708278 0.700195 2.33301)" stroke="#3369F3" />
            <line y1="-0.5" x2="5.6475" y2="-0.5" transform="matrix(0.705933 -0.708278 0.705933 0.708278 3.3584 5)"
                stroke="#3369F3" />
                {{#if isRead}}
            <line y1="-0.5" x2="5.6475" y2="-0.5" transform="matrix(0.705933 -0.708278 0.705933 0.708278 6.01611 5)"
                stroke="#3369F3" />
                {{/if}}
        </svg>
        <div class="message_time">
            {{time}}
        </div>
    </div>
</div>