<div class="dialog">
    <div class="dialog__header">
        <div class="dialog__header-data">
            <div class="user">
                {{{avatar}}}
                <span class="bold">{{name}}</span>
            </div>
            <div class="actions">
                {{{actionsButton}}}
                {{{actions}}}
            </div>
        </div>
        <div class="dialog-separator"></div>

    </div>

    <div class="dialog__body">
        {{{body}}}
    </div>
    <div class="dialog__footer">
        <div class="dialog-separator"></div>
        <div class="dialog__footer-data">
            {{{attachButton}}}
            {{{messageInput}}}
            {{{sendButton}}}
        </div>

    </div>
    {{{addUserModal}}}
    {{{deleteUserModal}}}
</div>