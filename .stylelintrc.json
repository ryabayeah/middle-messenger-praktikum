{
  "extends": ["stylelint-config-standard", "stylelint-config-recommended-scss"],
  "rules": {
    "selector-class-pattern": null,
    "color-function-notation": null,
    "unit-no-unknown": [
      true,
      {
        "ignoreFunctions": ["resolve", "percentage"]
      }
    ]
  },
  "ignoreFiles": ["/dist/*"]
}
